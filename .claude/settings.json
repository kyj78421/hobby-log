{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git check-ignore *)",
      "Bash(curl -s * http://localhost:*)",
      "Bash(curl -s -o /dev/null * http://localhost:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(supabase db reset*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_RETRY_WATCHDOG_USAGE_LIMIT_RECHECK_MS": "900000"
  }
}
